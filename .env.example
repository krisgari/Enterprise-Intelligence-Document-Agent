ANTHROPIC_API_KEY=your-api-key-here
RAGAGENT_MODEL=claude-sonnet-4-5-20250929

RAGAGENT_CHUNK_SIZE=800
RAGAGENT_CHUNK_OVERLAP=100
RAGAGENT_TOP_K=5
RAGAGENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

RAGAGENT_RAW_DIR=data/raw
RAGAGENT_PROCESSED_DIR=data/processed

# ChromaDB: leave CHROMA_HOST unset to use an embedded local client
# (persisted to CHROMA_PERSIST_DIR). Set CHROMA_HOST/PORT to point at
# a running Chroma server instead (see docker-compose.yml).
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=data/vectorstore
CHROMA_COLLECTION=ragagent_docs

# LangSmith tracing (optional but recommended). Get a key at smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ragagent
LANGSMITH_TRACING=false

# API auth: set this to any secret string to require it as the X-API-Key
# header on every request (except /health). Leave unset to disable auth
# for local development only.
RAGAGENT_API_KEY=

# Multi-tenancy: the tenant every query/ingest uses when it doesn't pass
# its own tenant_id. Change per-deployment, or just leave as "default"
# for single-tenant use.
RAGAGENT_DEFAULT_TENANT_ID=default
